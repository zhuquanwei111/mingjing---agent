<mxfile host="app.diagrams.net" compressed="false"><diagram id="mingjing" name="公共架构"><mxGraphModel grid="1" page="1" pageScale="1" pageWidth="1490" pageHeight="1490"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="band-control" value="" style="rounded=1;fillColor=#FAFCFC;strokeColor=#D7E0E2;" vertex="1" parent="1"><mxGeometry as="geometry" x="12" y="9" width="1466" height="158" /></mxCell><mxCell id="label-control" value="&lt;b&gt;控制面&lt;/b&gt;&lt;br&gt;定义与激活" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#41677A;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="20" width="150" height="60" /></mxCell><mxCell id="band-exec" value="" style="rounded=1;fillColor=#FAFCFC;strokeColor=#D7E0E2;" vertex="1" parent="1"><mxGeometry as="geometry" x="12" y="178" width="1466" height="303" /></mxCell><mxCell id="label-exec" value="&lt;b&gt;执行面&lt;/b&gt;&lt;br&gt;受理与执行" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#277162;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="189" width="150" height="60" /></mxCell><mxCell id="band-data" value="" style="rounded=1;fillColor=#FAFCFC;strokeColor=#D7E0E2;" vertex="1" parent="1"><mxGeometry as="geometry" x="12" y="492" width="1466" height="574" /></mxCell><mxCell id="label-data" value="&lt;b&gt;数据与能力面&lt;/b&gt;&lt;br&gt;事实与产物" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#5C6793;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="503" width="150" height="60" /></mxCell><mxCell id="band-gov" value="" style="rounded=1;fillColor=#FAFCFC;strokeColor=#D7E0E2;" vertex="1" parent="1"><mxGeometry as="geometry" x="12" y="1077" width="1466" height="295" /></mxCell><mxCell id="label-gov" value="&lt;b&gt;治理与观测面&lt;/b&gt;&lt;br&gt;记录从哪来" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#826B39;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="1088" width="150" height="60" /></mxCell><mxCell id="publisher" value="&lt;b&gt;能力与业务维护者&lt;/b&gt;&lt;br&gt;规则、条件、能力契约" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#FFFDFC;strokeColor=#7A7066;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="185" y="26" width="200" height="49" /></mxCell><mxCell id="registry" value="&lt;b&gt;Git 版本清单与 PG 发布状态&lt;/b&gt;&lt;br&gt;由宿主维护激活、停止和版本绑定" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#E8F1F5;strokeColor=#41677A;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="26" width="311" height="49" /></mxCell><mxCell id="configconsumer" value="&lt;b&gt;受理路由、工具目录与业务质量门&lt;/b&gt;&lt;br&gt;只取适用的已发布版本，再按当前主体和任务筛选" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#E4F3EF;strokeColor=#277162;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="832" y="26" width="578" height="49" /></mxCell><mxCell id="ids" value="&lt;b&gt;App 身份方／资源方&lt;/b&gt;&lt;br&gt;主体、对象、动作、撤权" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#FFFDFC;strokeColor=#7A7066;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="185" y="95" width="200" height="49" /></mxCell><mxCell id="policy" value="&lt;b&gt;当前权限与资源策略&lt;/b&gt;&lt;br&gt;权威决定在相应资源方；宿主维护映射" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#E8F1F5;strokeColor=#41677A;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="95" width="311" height="49" /></mxCell><mxCell id="gateuse" value="&lt;b&gt;五处核权：读、送模型、送工具、正式写、交付／读回&lt;/b&gt;&lt;br&gt;执行者在实际交接处检查。顺序不能确认时关闭该出口。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#E4F3EF;strokeColor=#277162;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="832" y="95" width="578" height="49" /></mxCell><mxCell id="in" value="&lt;b&gt;App／API／业务事件&lt;/b&gt;&lt;br&gt;登录或受托事件&lt;br&gt;01 · 带主体和对象" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#FFFDFC;strokeColor=#7A7066;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="183" y="270" width="168" height="72" /></mxCell><mxCell id="route" value="&lt;b&gt;Python 宿主受理&lt;/b&gt;&lt;br&gt;确认目标与依赖&lt;br&gt;03 · 按需路由" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#E4F3EF;strokeColor=#277162;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="386" y="270" width="171" height="72" /></mxCell><mxCell id="direct" value="&lt;b&gt;直接程序&lt;/b&gt;&lt;br&gt;已知、短时、有界的动作" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#E4F3EF;strokeColor=#277162;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="625" y="191" width="195" height="58" /></mxCell><mxCell id="temporal" value="&lt;b&gt;Temporal 工作流&lt;/b&gt;&lt;br&gt;确定性编排、等待与恢复" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#E4F3EF;strokeColor=#277162;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="625" y="276" width="195" height="58" /></mxCell><mxCell id="agent" value="&lt;b&gt;Pydantic AI&lt;/b&gt;&lt;br&gt;依据工具结果继续或终止" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#E4F3EF;strokeColor=#277162;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="625" y="361" width="195" height="62" /></mxCell><mxCell id="tools" value="&lt;b&gt;公共工具网关&lt;/b&gt;&lt;br&gt;02／08 · 筛选与验参&lt;br&gt;三入口共用能力标识" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#E4F3EF;strokeColor=#277162;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="944" y="244" width="218" height="72" /></mxCell><mxCell id="runner" value="&lt;b&gt;实际能力执行方&lt;/b&gt;&lt;br&gt;业务程序、API 或外部服务&lt;br&gt;受限读与正式写由资源方终核" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#FFFDFC;strokeColor=#7A7066;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="1200" y="244" width="235" height="72" /></mxCell><mxCell id="modelgate" value="&lt;b&gt;逐轮受控模型出口&lt;/b&gt;&lt;br&gt;07 · 当前权限、认领、预留" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#E4F3EF;strokeColor=#277162;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="944" y="371" width="218" height="61" /></mxCell><mxCell id="provider" value="&lt;b&gt;获准模型提供方&lt;/b&gt;&lt;br&gt;返回建议或工具请求" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#FFFDFC;strokeColor=#7A7066;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="1200" y="371" width="235" height="61" /></mxCell><mxCell id="facts" value="&lt;b&gt;获准的业务事实&lt;/b&gt;&lt;br&gt;05 · 业务服务保存权威版本" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#FFFDFC;strokeColor=#7A7066;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="182" y="508" width="246" height="49" /></mxCell><mxCell id="knowledge" value="&lt;b&gt;资料发布清单／知识检索&lt;/b&gt;&lt;br&gt;06 · 发布、撤回和依赖，RAG 实现待测" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#EEF0F9;strokeColor=#5C6793;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="182" y="573" width="246" height="55" /></mxCell><mxCell id="context" value="&lt;b&gt;Python 上下文装配&lt;/b&gt;&lt;br&gt;任务相关证据、配对消息、来源和版本" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#EEF0F9;strokeColor=#5C6793;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="546" y="534" width="303" height="60" /></mxCell><mxCell id="ctxout" value="&lt;b&gt;本轮模型出口&lt;/b&gt;&lt;br&gt;只发送当前允许的最小内容，使用 07 的实际交接边界" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#E4F3EF;strokeColor=#277162;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="968" y="534" width="437" height="60" /></mxCell><mxCell id="artifact" value="&lt;b&gt;候选产物&lt;/b&gt;&lt;br&gt;受控引用、对象&lt;br&gt;与依赖版本" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#EEF0F9;strokeColor=#5C6793;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="182" y="675" width="188" height="67" /></mxCell><mxCell id="quality" value="&lt;b&gt;业务验证器／质量门&lt;/b&gt;&lt;br&gt;10 · 校验必需条件&lt;br&gt;PG 保存版本化判定" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#E4F3EF;strokeColor=#277162;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="397" y="675" width="221" height="67" /></mxCell><mxCell id="write" value="&lt;b&gt;正式业务写入&lt;/b&gt;&lt;br&gt;10 · 仅适用时执行&lt;br&gt;业务端原子去重、存收据" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#FFFDFC;strokeColor=#7A7066;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="663" y="675" width="221" height="67" /></mxCell><mxCell id="inbox" value="&lt;b&gt;指定收件端&lt;/b&gt;&lt;br&gt;11 · 交付号去重&lt;br&gt;收件方保存接受收据" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#FFFDFC;strokeColor=#7A7066;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="923" y="675" width="215" height="67" /></mxCell><mxCell id="open" value="&lt;b&gt;获准用户读回&lt;/b&gt;&lt;br&gt;11 · 再核当前权限&lt;br&gt;接收与已读分别记录" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#FFFDFC;strokeColor=#7A7066;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="1177" y="675" width="234" height="67" /></mxCell><mxCell id="pg" value="&lt;b&gt;PG 产品任务账 · 宿主负责&lt;/b&gt;&lt;br&gt;01／03／04／09 · 目标修订、操作、预算&lt;br&gt;保留外部收据引用和可见进度" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#EEF0F9;strokeColor=#5C6793;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="182" y="798" width="382" height="67" /></mxCell><mxCell id="history" value="&lt;b&gt;Temporal 历史 · 引擎负责&lt;/b&gt;&lt;br&gt;03／09 · 活动、定时、等待、唤醒&lt;br&gt;仅携带不透明引用" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#E4F3EF;strokeColor=#277162;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="597" y="798" width="368" height="67" /></mxCell><mxCell id="checkpoint" value="&lt;b&gt;受控会话／检查点 · 宿主负责&lt;/b&gt;&lt;br&gt;07／09 · 原调用 ID、配对消息、版本&lt;br&gt;恢复需重核授权、来源与目标" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#EEF0F9;strokeColor=#5C6793;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="1000" y="798" width="412" height="67" /></mxCell><mxCell id="obs" value="&lt;b&gt;12　执行轨迹&lt;/b&gt;&lt;br&gt;API、Worker、网关与适配器 → OTel／OTLP&lt;br&gt;用于定位故障和耗时" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#F5EFE1;strokeColor=#826B39;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="182" y="1092" width="380" height="72" /></mxCell><mxCell id="audit" value="&lt;b&gt;13　持久审计&lt;/b&gt;&lt;br&gt;身份、资源、收件方 → 本端记录和 PG 关联&lt;br&gt;保留真实主体、权限决定、效果依据" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#F5EFE1;strokeColor=#826B39;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="596" y="1092" width="369" height="72" /></mxCell><mxCell id="meter" value="&lt;b&gt;14　计量与预算&lt;/b&gt;&lt;br&gt;模型／工具出口及供方用量 → PG 共享账&lt;br&gt;原始用量与供应商账单可核对" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#F5EFE1;strokeColor=#826B39;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="998" y="1092" width="416" height="72" /></mxCell><mxCell id="eval" value="&lt;b&gt;15　事后业务评测&lt;/b&gt;&lt;br&gt;授权样本、源收据与业务判断 → 版本化结果&lt;br&gt;pytest／业务断言，按需独立评判" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#F5EFE1;strokeColor=#826B39;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="182" y="1184" width="380" height="72" /></mxCell><mxCell id="product" value="&lt;b&gt;16　产品事件&lt;/b&gt;&lt;br&gt;获准的脱敏行为事件 → PostHog Cloud&lt;br&gt;已选，目标项目接通与外发待核" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#F5EFE1;strokeColor=#826B39;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="596" y="1184" width="369" height="72" /></mxCell><mxCell id="release" value="&lt;b&gt;版本、隔离与恢复&lt;/b&gt;&lt;br&gt;Git、发布状态、构建与运行诊断 → 运维&lt;br&gt;混合负载、回退与灾备需在目标环境验证" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#F5EFE1;strokeColor=#826B39;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="998" y="1184" width="416" height="72" /></mxCell><mxCell id="proof" value="&lt;b&gt;权威回执／原号查单&lt;/b&gt;&lt;br&gt;只能由授权对账主体取证" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#FFFDFC;strokeColor=#7A7066;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="182" y="894" width="326" height="62" /></mxCell><mxCell id="reconcile" value="&lt;b&gt;PG 对账器与待唤醒项&lt;/b&gt;&lt;br&gt;一次核销，同事务记可重复通知" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#EEF0F9;strokeColor=#5C6793;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="577" y="894" width="346" height="62" /></mxCell><mxCell id="wake" value="&lt;b&gt;Temporal 等待 → 原 Agent 回合&lt;/b&gt;&lt;br&gt;重新核权、校验目标与资料后认领；相同通知只续一次" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#E4F3EF;strokeColor=#277162;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="1000" y="894" width="412" height="62" /></mxCell><mxCell id="cancel" value="&lt;b&gt;目标修订／取消意图&lt;/b&gt;&lt;br&gt;宿主封住新的相关派发，并记原号" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#E4F3EF;strokeColor=#277162;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="182" y="977" width="326" height="62" /></mxCell><mxCell id="cadapter" value="&lt;b&gt;Temporal／能力适配器&lt;/b&gt;&lt;br&gt;向可取消的执行方发送幂等取消请求" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#E4F3EF;strokeColor=#277162;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="577" y="977" width="346" height="62" /></mxCell><mxCell id="cservice" value="&lt;b&gt;实际执行方 → 取消确认／在途事实&lt;/b&gt;&lt;br&gt;不可取消、已生效或未知时，迟到回执只对账" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#FFFDFC;strokeColor=#7A7066;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="1000" y="977" width="412" height="62" /></mxCell><mxCell id="gpre" value="&lt;b&gt;业务开发前 · 受控宿主同一任务&lt;/b&gt;&lt;br&gt;W0＋失败追查＋已知错误评测＋知识定位与撤回＋结果读回" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#E4F3EF;strokeColor=#277162;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="182" y="1395" width="593" height="65" /></mxCell><mxCell id="gmvp" value="&lt;b&gt;MVP 业务验收 · 首链从开始即接公共能力&lt;/b&gt;&lt;br&gt;有权场次与运营判断／排班实际占位／本人收件收据" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#E4F3EF;strokeColor=#277162;fontColor=#203A40;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="859" y="1395" width="553" height="65" /></mxCell><mxCell id="edge0" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#41677A;exitX=1.0000;exitY=0.5102;entryX=0.0000;entryY=0.5102;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="publisher" target="registry"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#41677A;exitX=1.0000;exitY=0.5102;entryX=0.0000;entryY=0.5102;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="registry" target="configconsumer"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge2" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#41677A;exitX=1.0000;exitY=0.5102;entryX=0.0000;entryY=0.5102;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="ids" target="policy"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge3" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#41677A;exitX=1.0000;exitY=0.5102;entryX=0.0000;entryY=0.5102;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="policy" target="gateuse"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge4" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#277162;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="in" target="route"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge5" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#277162;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="route" target="direct"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="586" y="306" /><mxPoint x="586" y="220" /></Array></mxGeometry></mxCell><mxCell id="edge6" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#277162;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="route" target="temporal"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="586" y="306" /><mxPoint x="586" y="305" /></Array></mxGeometry></mxCell><mxCell id="edge7" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#277162;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="route" target="agent"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="586" y="306" /><mxPoint x="586" y="392" /></Array></mxGeometry></mxCell><mxCell id="edge8" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColo