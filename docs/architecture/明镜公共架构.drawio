" target="provider"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge14" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#277162;exitX=0.3128;exitY=1.0000;entryX=0.3128;entryY=0.0000;exitPerimeter=0;entryPerimeter=0;dashed=1;startArrow=block;startFill=1;" edge="1" parent="1" source="temporal" target="agent"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge15" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#5C6793;exitX=1.0000;exitY=0.4898;entryX=0.0000;entryY=0.2833;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="facts" target="context"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="488" y="532" /><mxPoint x="488" y="551" /></Array></mxGeometry></mxCell><mxCell id="edge16" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#5C6793;exitX=1.0000;exitY=0.4909;entryX=0.0000;entryY=0.7167;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="knowledge" target="context"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="488" y="600" /><mxPoint x="488" y="577" /></Array></mxGeometry></mxCell><mxCell id="edge17" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#5C6793;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="context" target="ctxout"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge18" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#5C6793;exitX=1.0000;exitY=0.5075;entryX=0.0000;entryY=0.5075;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="artifact" target="quality"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge19" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#5C6793;exitX=1.0000;exitY=0.5075;entryX=0.0000;entryY=0.5075;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="quality" target="write"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge20" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#5C6793;exitX=1.0000;exitY=0.5075;entryX=0.0000;entryY=0.5075;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="write" target="inbox"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge21" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#5C6793;exitX=1.0000;exitY=0.5075;entryX=0.0000;entryY=0.5075;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="inbox" target="open"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge22" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#5C6793;exitX=0.4977;exitY=1.0000;entryX=0.4977;entryY=1.0000;exitPerimeter=0;entryPerimeter=0;dashed=1;" edge="1" parent="1" source="quality" target="inbox"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="507" y="759" /><mxPoint x="1030" y="759" /></Array></mxGeometry></mxCell><mxCell id="edge23" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#5C6793;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="proof" target="reconcile"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge24" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#5C6793;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="reconcile" target="wake"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge25" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#5C6793;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="cancel" target="cadapter"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge26" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#5C6793;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="cadapter" target="cservice"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge27" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#277162;exitX=1.0000;exitY=0.4923;entryX=0.0000;entryY=0.4923;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="gpre" target="gmvp"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="note0" value="实线为调用。虚线连接持久等待与原工具回合续接。执行正式写时，网关与业务端均执行下方 10 的质量及权限约束。" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#365661;" vertex="1" parent="1"><mxGeometry as="geometry" x="184" y="439" width="1266" height="24" /></mxCell><mxCell id="note1" value="分项完成条件由任务契约声明。仅需同步回答时直接经当前权限返回。需要持久交付时按下链路取证。" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#365661;" vertex="1" parent="1"><mxGeometry as="geometry" x="182" y="637" width="1268" height="24" /></mxCell><mxCell id="note2" value="任务仅要求交付时，合格产物可直接发往收件方。" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#365661;" vertex="1" parent="1"><mxGeometry as="geometry" x="573" y="762" width="877" height="24" /></mxCell><mxCell id="note3" value="治理共享 Task／Run／操作等关联标识。采样遥测、产品事件、业务审计、费用和评测分别取证。" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#365661;" vertex="1" parent="1"><mxGeometry as="geometry" x="182" y="1279" width="1268" height="24" /></mxCell><mxCell id="note4" value="配色：蓝色为控制，绿色为执行，紫色为数据与能力，沙色为治理，白色为 App、资源所有方或外部服务。" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#365661;" vertex="1" parent="1"><mxGeometry as="geometry" x="182" y="1312" width="1268" height="24" /></mxCell><mxCell id="note5" value="验收时点" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#365661;" vertex="1" parent="1"><mxGeometry as="geometry" x="29" y="1416" width="1421" height="24" /></mxCell></root></mxGraphModel></diagram></mxfile>